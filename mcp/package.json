{
  "name": "careloop-mcp",
  "version": "1.0.0",
  "description": "CareLoop Model Context Protocol (MCP) server for Claude Desktop, Claude Code, and remote MCP clients.",
  "private": true,
  "type": "module",
  "main": "dist/local.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/local.ts",
    "dev:stdio": "tsx src/local.ts --stdio",
    "build": "tsc",
    "start": "node dist/local.js",
    "start:stdio": "node dist/local.js --stdio"
  },
  "dependencies": {
    "@ai-sdk/voyage": "^2.0.39",
    "@modelcontextprotocol/sdk": "^1.5.0",
    "@supabase/supabase-js": "^2.45.4",
    "ai": "^7.0.97",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2"
  }
}
